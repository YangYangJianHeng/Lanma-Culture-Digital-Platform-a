.page { padding: 24rpx 24rpx 80rpx; background: #f5f5f5; min-height: 100vh; }

.hero {
  background: linear-gradient(135deg, #b71c1c, #d32f2f 60%, #f57c00);
  color: #fff;
  padding: 32rpx; border-radius: 24rpx;
  display: flex; align-items: center; gap: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(183,28,28,0.2);
}
.hero-icon { font-size: 80rpx; line-height: 1; }
.hero-content { flex: 1; }
.hero-title { font-size: 36rpx; font-weight: 700; }
.hero-sub { font-size: 24rpx; opacity: 0.9; margin-top: 8rpx; }

.tab-row { white-space: nowrap; padding: 16rpx 0; }
.tab-chip {
  display: inline-flex; align-items: center; gap: 8rpx;
  background: #fff; color: #555;
  padding: 12rpx 20rpx; border-radius: 32rpx;
  font-size: 24rpx; margin-right: 12rpx; flex-shrink: 0;
}
.tab-chip.active { background: linear-gradient(135deg, #b71c1c, #d32f2f); color: #fff; }
.tab-hover { transform: scale(0.96); transition: transform 0.15s; }
.tab-count {
  background: rgba(255,255,255,0.2); padding: 2rpx 10rpx;
  border-radius: 16rpx; font-size: 20rpx;
}
.tab-chip.active .tab-count { background: rgba(255,255,255,0.25); }

.loading { text-align: center; padding: 100rpx 0; }

.empty-state { text-align: center; padding: 100rpx 0; }
.empty-icon { font-size: 120rpx; opacity: 0.6; }
.empty-title { font-size: 30rpx; color: #666; margin-top: 16rpx; }
.empty-sub { font-size: 24rpx; margin-top: 8rpx; }

.grid {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx;
}
.fav-card { background: #fff; border-radius: 16rpx; padding: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.card-hover { transform: scale(0.98); transition: transform 0.15s; }

.fav-cover {
  width: 100%; height: 280rpx; border-radius: 12rpx;
  background: #f0f0f0;
}
.fav-fallback {
  background: #fff5f5;
  display: flex; align-items: center; justify-content: center;
  font-size: 80rpx; color: #b71c1c;
}
.fav-name {
  font-size: 28rpx; font-weight: 500; color: #333;
  margin-top: 12rpx;
  display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
}
.fav-foot {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 8rpx;
}
.fav-meta { font-size: 22rpx; color: #888; }
.fav-unfav {
  padding: 4rpx 12rpx; font-size: 22rpx; color: #999;
  background: #f5f5f5; border-radius: 16rpx;
}