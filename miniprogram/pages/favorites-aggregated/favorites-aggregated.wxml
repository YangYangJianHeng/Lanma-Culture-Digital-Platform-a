<view class="page">
  <view class="hero">
    <view class="hero-icon">⭐</view>
    <view class="hero-content">
      <view class="hero-title">我的收藏</view>
      <view class="hero-sub">已收藏 {{counts.all}} 个内容</view>
    </view>
  </view>

  <!-- 分类标签 -->
  <scroll-view scroll-x class="tab-row" enable-flex show-scrollbar="{{false}}">
    <view class="tab-chip {{activeTab == item.key ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="key"
          data-key="{{item.key}}" bindtap="onTabTap" hover-class="tab-hover">
      <text>{{item.label}}</text>
      <text class="tab-count" wx:if="{{counts[item.key]}}">{{counts[item.key]}}</text>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="loading text-muted">加载中…</view>

  <view wx:elif="{{list.length === 0}}" class="empty-state">
    <view class="empty-icon">📭</view>
    <view class="empty-title">还没有收藏</view>
    <view class="empty-sub text-muted">在各个模块点击 ⭐ 即可添加收藏</view>
  </view>

  <view wx:else class="grid">
    <view class="fav-card card" wx:for="{{list}}" wx:key="type"
          data-type="{{item.type}}" data-id="{{item.id}}"
          bindtap="goItem" hover-class="card-hover">
      <image wx:if="{{item.image}}" src="{{item.image}}" class="fav-cover" mode="aspectFill" lazy-load="{{true}}"></image>
      <view wx:else class="fav-cover fav-fallback">
        <text wx:if="{{item.type == 'food'}}">🍜</text>
        <text wx:elif="{{item.type == 'tourism'}}">🗺</text>
        <text wx:elif="{{item.type == 'landmark'}}">📍</text>
        <text wx:elif="{{item.type == 'medal'}}">🏅</text>
        <text wx:else>⭐</text>
      </view>
      <view class="fav-name">{{item.name}}</view>
      <view class="fav-foot">
        <text class="fav-meta">{{item.meta}}</text>
        <text class="fav-unfav" catchtap="onUnfav" data-type="{{item.type}}" data-id="{{item.id}}">✕</text>
      </view>
    </view>
  </view>
</view>