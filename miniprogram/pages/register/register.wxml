<view class="register-page">
  <view class="form-card">
    <input class="input" placeholder="用户名（必填）" data-field="username" bindinput="onInput" />
    <input class="input" password placeholder="密码（至少6位）" data-field="password" bindinput="onInput" />
    <input class="input" password placeholder="确认密码" data-field="confirm" bindinput="onInput" />
    <input class="input" placeholder="邮箱（选填）" data-field="email" bindinput="onInput" />
    <input class="input" placeholder="职业（用于个性化推荐）" data-field="occupation" bindinput="onInput" />

    <button class="btn-primary" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '注册中...' : '注 册'}}
    </button>
  </view>
</view>
