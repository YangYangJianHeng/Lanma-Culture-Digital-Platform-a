.page { padding: 24rpx; padding-bottom: 180rpx; min-height: 100vh; background: #f5f5f5; }

.header-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx; margin-bottom: 24rpx;
}
.title-block .title { font-size: 34rpx; font-weight: 700; }
.title-block .title-sub { font-size: 22rpx; color: #999; margin-top: 6rpx; }

.add-btn {
  background: linear-gradient(135deg, #b71c1c, #d32f2f); color: #fff;
  border-radius: 36rpx; padding: 14rpx 28rpx; font-size: 26rpx;
}
.btn-hover { opacity: 0.85; transform: scale(0.97); }

.empty {
  text-align: center;
  padding: 100rpx 0 60rpx;
  color: #aaa;
  font-size: 28rpx;
}
.empty-icon { font-size: 96rpx; opacity: 0.6; margin-bottom: 16rpx; }
.empty-tip { font-size: 24rpx; color: #bbb; margin-top: 16rpx; }

.story-item {
  padding: 24rpx;
  margin-bottom: 20rpx;
  position: relative;
}
.card-hover { transform: scale(0.99); transition: transform 0.15s; }

.story-cover {
  width: 100%; height: 280rpx; border-radius: 12rpx;
  margin-bottom: 16rpx; background: #eee;
}

.story-head {
  display: flex; align-items: flex-start; justify-content: space-between;
}
.story-title { font-size: 30rpx; font-weight: 600; flex: 1; line-height: 1.4; padding-right: 16rpx; }
.more-btn {
  width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center;
  font-size: 36rpx; color: #999;
  background: #f5f5f5; border-radius: 50%;
}

.story-meta {
  display: flex; flex-wrap: wrap; gap: 8rpx; align-items: center;
  margin-top: 12rpx;
}
.story-meta .dot { color: #ccc; }
.public-tag {
  padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 22rpx;
}
.public-tag.public { background: #e8f5e9; color: #2e7d32; }
.public-tag.private { background: #fff3c4; color: #b71c1c; }

.story-content {
  font-size: 26rpx; color: #555; line-height: 1.7;
  margin-top: 12rpx;
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
}

.story-stats {
  display: flex; align-items: center; gap: 8rpx;
  margin-top: 12rpx; padding-top: 12rpx;
  border-top: 1rpx dashed #eee;
  font-size: 24rpx; color: #888;
}
.stats-divider { color: #ccc; }

.float-add {
  position: fixed; right: 40rpx; bottom: 140rpx;
  width: 110rpx; height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #b71c1c, #d32f2f);
  color: #fff;
  font-size: 64rpx; line-height: 110rpx; text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(183,28,28,0.4);
  z-index: 99;
}