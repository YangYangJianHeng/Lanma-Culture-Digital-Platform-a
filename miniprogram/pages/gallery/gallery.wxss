.page { padding: 24rpx; background: #f5f5f5; min-height: 100vh; padding-bottom: 80rpx; }

.hero {
  background: linear-gradient(135deg, #1a237e 0%, #283593 50%, #3949ab 100%);
  color: #fff;
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(26,35,126,0.25);
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute; top: -40rpx; right: -40rpx;
  width: 200rpx; height: 200rpx; border-radius: 50%;
  background: rgba(255,255,255,0.06);
}
.hero::after {
  content: '';
  position: absolute; bottom: -60rpx; right: 60rpx;
  width: 140rpx; height: 140rpx; border-radius: 50%;
  background: rgba(255,255,255,0.04);
}
.hero-content { flex: 1; z-index: 1; }
.hero-title { font-size: 38rpx; font-weight: 700; }
.hero-sub { font-size: 22rpx; opacity: 0.85; margin-top: 8rpx; }
.hero-tag {
  background: rgba(255,255,255,0.15);
  padding: 8rpx 20rpx; border-radius: 32rpx;
  font-size: 22rpx; letter-spacing: 2rpx; font-weight: 700;
  z-index: 1;
}

.tab-row { white-space: nowrap; padding: 12rpx 0 16rpx; }
.tab-chip {
  display: inline-block;
  background: #fff; color: #555;
  padding: 10rpx 20rpx; border-radius: 32rpx;
  font-size: 24rpx; margin-right: 12rpx; flex-shrink: 0;
}
.tab-chip.active { background: linear-gradient(135deg, #1a237e, #3949ab); color: #fff; }
.tab-hover { transform: scale(0.96); transition: transform 0.15s; }

.grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }

.ex-card {
  position: relative;
  padding: 12rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.card-hover { transform: scale(0.98); transition: transform 0.15s; }
.ex-cover {
  width: 100%; height: 280rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  margin-bottom: 8rpx;
}
.ex-cover.fallback {
  background: #e8eaf6;
  display: flex; align-items: center; justify-content: center;
  font-size: 80rpx; color: #3949ab;
}
.ex-cat-tag {
  position: absolute; top: 24rpx; left: 24rpx;
  background: rgba(0,0,0,0.5); color: #fff;
  padding: 4rpx 14rpx; border-radius: 16rpx;
  font-size: 20rpx;
}
.ex-360 {
  position: absolute; top: 24rpx; right: 24rpx;
  background: linear-gradient(135deg, #ff6f00, #ff8f00);
  color: #fff;
  padding: 4rpx 14rpx; border-radius: 16rpx;
  font-size: 20rpx; font-weight: 700;
  letter-spacing: 1rpx;
}
.ex-name {
  font-size: 26rpx; font-weight: 600; color: #333;
  display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
}
.ex-year { font-size: 20rpx; color: #888; margin-top: 2rpx; }

/* 骨架 */
.skel { background: linear-gradient(90deg, #eee 0%, #f5f5f5 50%, #eee 100%); background-size: 200% 100%; animation: shimmer 1.4s infinite; }
.skel-line {
  height: 16rpx; margin-top: 12rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #eee 0%, #f5f5f5 50%, #eee 100%);
  background-size: 200% 100%; animation: shimmer 1.4s infinite;
}
.w70 { width: 70%; }
.w40 { width: 40%; }
@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

.empty { text-align: center; padding: 100rpx 0; color: #aaa; font-size: 26rpx; }
.empty-icon { font-size: 96rpx; opacity: 0.6; margin-bottom: 12rpx; }

/* 详情 */
.detail-mask {
  position: fixed; inset: 0;
  background: #000; z-index: 999;
  display: flex; align-items: center; justify-content: center;
  animation: fadeIn 0.25s ease;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.detail-wrap {
  width: 100%; height: 100%;
  display: flex; flex-direction: column;
}
.detail-3d {
  position: relative;
  flex: 1;
  background: linear-gradient(135deg, #0a0e27, #1a237e 50%, #0a0e27);
  overflow: hidden;
  transition: background 0.3s;
}
.detail-3d.immersive { background: #000; }
.angle-swiper { width: 100%; height: 100%; }
.angle-img { width: 100%; height: 100%; }
.angle-fallback {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 240rpx; color: rgba(255,255,255,0.3);
}

.ctrl-top {
  position: absolute; top: 24rpx; left: 24rpx; right: 24rpx;
  display: flex; justify-content: space-between;
  z-index: 10;
}
.ctrl-btn {
  background: rgba(255,255,255,0.18);
  color: #fff; backdrop-filter: blur(20rpx);
  padding: 12rpx 24rpx; border-radius: 32rpx;
  font-size: 24rpx;
}
.btn-hover { transform: scale(0.96); transition: transform 0.15s; }
.ctrl-close {
  background: rgba(255,255,255,0.18);
  color: #fff; backdrop-filter: blur(20rpx);
  width: 64rpx; height: 64rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
}

.angle-dots {
  position: absolute; bottom: 32rpx; left: 0; right: 0;
  display: flex; justify-content: center; gap: 12rpx;
  z-index: 10;
}
.dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: rgba(255,255,255,0.3);
  transition: all 0.2s;
}
.dot.active {
  background: #fff;
  width: 40rpx; border-radius: 8rpx;
}

.gyro-hint {
  position: absolute; bottom: 80rpx; left: 0; right: 0;
  text-align: center;
  background: rgba(0,0,0,0.5); color: #fff;
  padding: 12rpx; font-size: 22rpx;
  margin: 0 auto; width: fit-content;
  padding: 8rpx 24rpx; border-radius: 32rpx;
}

.detail-info {
  background: #fff;
  padding: 32rpx 24rpx;
  border-top-left-radius: 28rpx; border-top-right-radius: 28rpx;
  box-shadow: 0 -8rpx 24rpx rgba(0,0,0,0.1);
}
.detail-name { font-size: 36rpx; font-weight: 700; color: #222; }
.detail-desc { font-size: 26rpx; color: #666; margin-top: 12rpx; line-height: 1.6; }
.detail-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.action-btn {
  flex: 1; text-align: center;
  background: #fff5f5; color: #b71c1c;
  border: 2rpx solid #fbe9e7; border-radius: 48rpx;
  padding: 18rpx; font-size: 28rpx;
}
.action-btn.primary { background: linear-gradient(135deg, #1a237e, #3949ab); color: #fff; border: none; }
.action-btn.share { background: #fff5f5; color: #b71c1c; border: 2rpx solid #fbe9e7; }
.action-btn.share::after { border: none; }

.preview-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.95); z-index: 9999;
  display: flex; align-items: center; justify-content: center;
}
.preview-img { width: 100%; height: 90vh; }
.preview-close {
  position: absolute; bottom: 60rpx; left: 0; right: 0;
  text-align: center; color: #fff; font-size: 24rpx;
  opacity: 0.7;
}