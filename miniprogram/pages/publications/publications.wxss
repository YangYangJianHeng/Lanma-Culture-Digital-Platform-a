.page { padding: 24rpx; background: #f5f5f5; min-height: 100vh; padding-bottom: 60rpx; }

.list { display: flex; flex-direction: column; gap: 24rpx; }

.pub-card { padding: 0; overflow: hidden; }
.card-hover { transform: scale(0.99); transition: transform 0.15s; }
.pub-cover {
  position: relative;
  width: 100%; height: 320rpx; background: #eee;
}
.pub-cover image { width: 100%; height: 100%; }
.pub-cat {
  position: absolute; top: 16rpx; left: 16rpx;
  background: rgba(183,28,28,0.9); color: #fff;
  padding: 6rpx 16rpx; border-radius: 8rpx; font-size: 22rpx;
}

.pub-body { padding: 24rpx; }
.pub-title { font-size: 32rpx; font-weight: 600; line-height: 1.4; }
.pub-summary {
  font-size: 26rpx; color: #666; margin-top: 12rpx;
  line-height: 1.6;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.pub-meta { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; font-size: 22rpx; color: #999; }
.pub-time { color: #999; }

/* 详情弹层 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 999; display: flex; align-items: flex-end; animation: fadeIn 0.2s ease; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.modal {
  width: 100%; max-height: 92vh;
  background: #fafafa; border-top-left-radius: 28rpx; border-top-right-radius: 28rpx;
  overflow-y: auto; position: relative;
  animation: slideUp 0.25s ease;
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

.modal-cover {
  display: block; width: 100%; height: 400rpx; background: linear-gradient(135deg, #b71c1c, #d32f2f);
}
.modal-cover.fallback {
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 120rpx;
}

.modal-body { padding: 24rpx 24rpx 140rpx; }
.modal-cat {
  display: inline-block;
  background: #fbe9e7; color: #b71c1c;
  padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 22rpx;
}
.modal-title { font-size: 40rpx; font-weight: 700; line-height: 1.4; margin-top: 16rpx; }
.modal-meta { font-size: 24rpx; color: #999; margin-top: 12rpx; }
.modal-sum {
  font-size: 28rpx; color: #555; margin-top: 24rpx;
  padding: 20rpx; background: #fff; border-radius: 12rpx;
  border-left: 6rpx solid #b71c1c; line-height: 1.7;
}

.modal-divider {
  height: 1rpx; background: linear-gradient(to right, transparent, #ddd, transparent);
  margin: 32rpx 0 24rpx;
}

.modal-content {
  font-size: 30rpx; color: #333; line-height: 1.9;
}
.modal-source {
  margin-top: 32rpx; padding-top: 24rpx; border-top: 1rpx dashed #eee;
  font-size: 22rpx; color: #999; text-align: center;
}

.share-btn {
  margin-top: 32rpx;
  background: #fff5f5; color: #b71c1c;
  border: 2rpx solid #fbe9e7; border-radius: 48rpx;
  font-size: 28rpx;
}
.share-btn::after { border: none; }

.modal-close {
  position: absolute; bottom: 24rpx; left: 24rpx; right: 24rpx;
  background: #fff; color: #b71c1c; text-align: center;
  padding: 22rpx; border-radius: 48rpx; border: 2rpx solid #b71c1c;
  font-size: 28rpx;
}