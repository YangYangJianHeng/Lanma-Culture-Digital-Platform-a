.page { padding: 0 0 80rpx; min-height: 100vh; background: #f5f5f5; }

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #b71c1c, #d32f2f 70%, #f57c00);
  color: #fff;
  padding: 40rpx 32rpx 32rpx;
  border-bottom-left-radius: 24rpx; border-bottom-right-radius: 24rpx;
}
.user-row { display: flex; align-items: center; }
.avatar-wrap {
  width: 128rpx; height: 128rpx;
  background: rgba(255,255,255,0.18);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  border: 4rpx solid rgba(255,255,255,0.4);
}
.avatar { width: 112rpx; height: 112rpx; border-radius: 50%; }
.avatar-fallback {
  width: 112rpx; height: 112rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,0.25); color: #fff; font-size: 50rpx; font-weight: 600;
}
.avatar-hover { transform: scale(0.96); transition: transform 0.15s; }

.user-info { flex: 1; margin-left: 20rpx; }
.user-name { font-size: 36rpx; font-weight: 700; }
.user-sub { font-size: 24rpx; color: rgba(255,255,255,0.85); margin-top: 6rpx; }
.user-meta { font-size: 22rpx; margin-top: 8rpx; opacity: 0.85; }

.edit-btn {
  background: rgba(255,255,255,0.18); color: #fff;
  border-radius: 32rpx; padding: 10rpx 24rpx;
  border: 2rpx solid rgba(255,255,255,0.4);
  font-size: 24rpx;
}
.btn-hover { transform: scale(0.96); transition: transform 0.15s; }

.stats-row {
  display: flex; justify-content: space-around;
  background: rgba(255,255,255,0.15);
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  margin-top: 32rpx;
}
.stat-item { text-align: center; flex: 1; }
.stat-num { font-size: 36rpx; font-weight: 700; }
.stat-label { font-size: 22rpx; opacity: 0.85; margin-top: 4rpx; }

/* 卡片 */
.card {
  background: #fff; margin: 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
}
.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }

/* 徽章 */
.badge-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.badge {
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  filter: grayscale(1);
  opacity: 0.55;
}
.badge.unlocked {
  background: linear-gradient(135deg, #fff5f5, #fff8e1);
  filter: none; opacity: 1;
}
.badge-icon {
  font-size: 48rpx;
  width: 80rpx; height: 80rpx; line-height: 80rpx;
  margin: 0 auto 12rpx;
  background: #fff; border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.06);
}
.badge-name { font-size: 26rpx; font-weight: 600; color: #333; }
.badge-desc { font-size: 20rpx; color: #888; margin-top: 4rpx; line-height: 1.4; }

/* 菜单 */
.menu { display: flex; flex-direction: column; }
.menu-item {
  display: flex; align-items: center;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.menu-item:last-child { border-bottom: none; }
.menu-hover { background: #fafafa; }
.menu-icon { width: 60rpx; height: 60rpx; font-size: 36rpx; display:flex; align-items:center; justify-content:center; margin-right: 16rpx; }
.menu-name { flex: 1; font-size: 28rpx; color: #333; }
.menu-arrow { color: #bbb; font-size: 36rpx; }
.menu-admin {
  background: linear-gradient(90deg, rgba(255, 215, 110, 0.12) 0%, transparent 100%);
  border-radius: 8rpx;
  border: 1rpx solid rgba(255, 215, 110, 0.3);
}
.menu-admin .menu-name { color: #b71c1c; font-weight: 600; }

.logout-btn {
  margin: 24rpx;
  background: #fff; color: #b71c1c;
  border: 2rpx solid #fbe9e7;
  text-align: center; padding: 24rpx;
  border-radius: 16rpx; font-size: 30rpx;
}

.footer { text-align: center; padding: 24rpx 0 0; }