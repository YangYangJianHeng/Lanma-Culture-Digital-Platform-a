<view class="page">
  <view class="filter-bar">
    <view class="chip {{filter == '' ? 'active' : ''}}" data-filter="" bindtap="onFilterTap">全部</view>
    <view class="chip {{filter == '1' ? 'active' : ''}}" data-filter="1" bindtap="onFilterTap">⭐ 精选</view>
    <view class="sort-wrap">
      <picker mode="selector" range="{{sortOptions}}" range-key="label" value="{{sortIndex}}" bindchange="onSortChange">
        <view class="sort-btn">↕ {{sortOptions[sortIndex].label}}</view>
      </picker>
    </view>
  </view>

  <!-- 年份轴 -->
  <scroll-view wx:if="{{years.length > 0}}" scroll-x class="year-row" enable-flex>
    <view class="year-chip" wx:for="{{years}}" wx:key="*this" data-year="{{item}}" bindtap="onYearJump">{{item}}</view>
  </scroll-view>

  <!-- 加载骨架屏 -->
  <view wx:if="{{loading}}" class="grid">
    <view class="medal-card card" wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this">
      <view class="medal-img skel"></view>
      <view class="skel-line w70"></view>
      <view class="skel-line w40"></view>
    </view>
  </view>

  <view wx:elif="{{medals.length === 0}}" class="empty">
    <view class="empty-icon">🏅</view>
    <view>暂无奖牌</view>
  </view>

  <view wx:else class="grid">
    <view class="medal-card card" wx:for="{{medals}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail" hover-class="card-hover">
      <view class="medal-img-wrap">
        <image wx:if="{{item.thumbnail_url}}" src="{{item.thumbnail_url}}" class="medal-img" mode="aspectFit" lazy-load="{{true}}"></image>
        <view wx:else class="medal-img fallback">🏅</view>
        <view wx:if="{{item.is_featured === 1}}" class="featured-tag">⭐ 精选</view>
      </view>
      <view class="medal-title">{{item.name}}</view>
      <view class="medal-year">{{item.year}} 年</view>
    </view>
  </view>

  <!-- 详情弹层 -->
  <view class="modal-mask" wx:if="{{detail}}" bindtap="closeDetail">
    <view class="modal" catchtap="noop">
      <view class="modal-hero">
        <view wx:if="{{!detailImageLoaded && detail}}" class="modal-hero-img skel-hero">🏅</view>
        <image wx:if="{{detail.imageUrl}}" src="{{detail.imageUrl}}"
               class="modal-hero-img {{detailImageLoaded ? 'fade-in' : 'pre-load'}}"
               mode="aspectFit" lazy-load="{{true}}"
               bindload="onDetailImageLoad"
               bindtap="onPreviewImage"></image>
        <view wx:else class="modal-hero-img fallback">🏅</view>
        <view class="modal-year-tag">{{detail.year || '—'}} 年</view>
        <view wx:if="{{detail.is_featured === 1}}" class="modal-featured">⭐ 精选</view>
      </view>
      <view class="modal-body">
        <view class="modal-title">{{detail.name}}</view>
        <view class="modal-meta">
          <text wx:if="{{detail.is_featured === 1}}" class="tag tag-gold">⭐ 精选</text>
          <text wx:if="{{detail.material}}" class="tag tag-gray">材质：{{detail.material}}</text>
          <text wx:if="{{detail.weight}}" class="tag tag-gray">克重：{{detail.weight}}</text>
        </view>

        <view wx:if="{{detail.theme}}" class="modal-section">
          <view class="modal-section-title">🏅 设计主题</view>
          <view class="modal-section-body">{{detail.theme}}</view>
        </view>

        <view wx:if="{{detail.description}}" class="modal-section">
          <view class="modal-section-title">📖 奖牌故事</view>
          <view class="modal-section-body">{{detail.description}}</view>
        </view>

        <view wx:if="{{detail.designer || detail.manufacturer}}" class="modal-section">
          <view class="modal-section-title">🎨 设计师 / 制作方</view>
          <view class="modal-section-body">
            <view wx:if="{{detail.designer}}">设计：{{detail.designer}}</view>
            <view wx:if="{{detail.manufacturer}}">制作：{{detail.manufacturer}}</view>
          </view>
        </view>

        <view class="modal-actions">
          <view class="action-btn" catchtap="onToggleFav" data-id="{{detail.id}}">
            {{detailFav ? '★ 已收藏' : '☆ 收藏'}}
          </view>
          <button class="share-btn" open-type="share">
            <text>🔗 分享好友</text>
          </button>
        </view>
        <button class="poster-btn" catchtap="onGeneratePoster" data-id="{{detail.id}}">
          🖼 生成海报卡 (保存到相册分享)
        </button>
        <view class="modal-close" bindtap="closeDetail">关闭</view>
      </view>
    </view>
  </view>
</view>