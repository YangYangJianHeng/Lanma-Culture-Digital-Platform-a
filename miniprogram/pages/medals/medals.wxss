.page { padding: 24rpx; background: #f5f5f5; min-height: 100vh; padding-bottom: 80rpx; }

.filter-bar { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.chip {
  padding: 10rpx 24rpx; background: #fff; color: #666;
  border-radius: 24rpx; font-size: 26rpx;
}
.chip.active { background: #b71c1c; color: #fff; }

.sort-wrap { margin-left: auto; }
.sort-btn {
  padding: 10rpx 20rpx; background: #fff5f5; color: #b71c1c;
  border-radius: 24rpx; font-size: 24rpx; border: 2rpx solid #fbe9e7;
}

.year-row { white-space: nowrap; padding-bottom: 20rpx; }
.year-chip {
  display: inline-block; padding: 6rpx 22rpx;
  background: #fff; color: #b71c1c; border: 2rpx solid #fbe9e7;
  border-radius: 24rpx; font-size: 24rpx; margin-right: 12rpx;
}

.grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.medal-card {
  width: calc((100% - 16rpx) / 2);
  padding: 16rpx;
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  display: flex; flex-direction: column; align-items: center;
}
.card-hover { transform: scale(0.98); transition: transform 0.15s; }
.medal-img-wrap { position: relative; width: 200rpx; height: 200rpx; }
.medal-img {
  width: 200rpx; height: 200rpx;
  background: linear-gradient(135deg, #fff8e1, #ffecb3); border-radius: 12rpx;
}
.fallback {
  display: flex; align-items: center; justify-content: center;
  font-size: 80rpx; color: #b71c1c;
}
.medal-title { margin-top: 16rpx; font-size: 28rpx; font-weight: 600; text-align: center; }
.medal-year { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.featured-tag {
  position: absolute; top: 4rpx; right: 4rpx;
  background: #ffd54f; color: #5d4037; font-size: 20rpx;
  padding: 2rpx 12rpx; border-radius: 8rpx;
}

/* 骨架屏 */
.skel { background: linear-gradient(90deg, #eee 0%, #f5f5f5 50%, #eee 100%); background-size: 200% 100%; animation: shimmer 1.4s infinite; }
.skel-line {
  height: 20rpx; margin-top: 12rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #eee 0%, #f5f5f5 50%, #eee 100%);
  background-size: 200% 100%; animation: shimmer 1.4s infinite;
}
.w70 { width: 70%; }
.w40 { width: 40%; }
@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

.empty { text-align: center; padding: 100rpx 0; color: #aaa; font-size: 26rpx; }
.empty-icon { font-size: 96rpx; opacity: 0.6; margin-bottom: 12rpx; }

/* 详情 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 999; display: flex; align-items: flex-end; animation: fadeIn 0.2s ease; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.modal {
  width: 100%; max-height: 88vh;
  background: #f5f5f5; border-top-left-radius: 28rpx; border-top-right-radius: 28rpx;
  overflow-y: auto; position: relative;
  animation: slideUp 0.25s ease;
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

.modal-hero {
  position: relative;
  background: linear-gradient(135deg, #fff8e1, #ffe0b2);
  padding: 40rpx 0 24rpx;
  display: flex; justify-content: center;
}
.modal-hero-img {
  width: 360rpx; height: 360rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.08);
  transition: opacity 0.3s;
}
.modal-hero-img.fallback {
  display: flex; align-items: center; justify-content: center;
  font-size: 120rpx; color: #b71c1c;
}
.modal-hero-img.skel-hero {
  background: linear-gradient(90deg, #eee 0%, #f5f5f5 50%, #eee 100%);
  background-size: 200% 100%; animation: shimmer 1.4s infinite;
}
.pre-load { opacity: 0; }
.fade-in { opacity: 1; }
.modal-year-tag {
  position: absolute; top: 16rpx; right: 24rpx;
  background: rgba(183,28,28,0.92); color: #fff;
  padding: 8rpx 20rpx; border-radius: 24rpx; font-size: 24rpx; font-weight: 600;
}
.modal-featured {
  position: absolute; top: 16rpx; left: 24rpx;
  background: #ffd54f; color: #5d4037;
  padding: 8rpx 20rpx; border-radius: 24rpx; font-size: 22rpx; font-weight: 600;
}

.modal-body { padding: 32rpx 24rpx 120rpx; }
.modal-title { font-size: 38rpx; font-weight: 700; }
.modal-meta { display: flex; gap: 12rpx; flex-wrap: wrap; margin: 16rpx 0 24rpx; }
.tag-gold { background: #fff3c4; color: #b71c1c; padding: 4rpx 14rpx; border-radius: 16rpx; font-size: 22rpx; }
.tag-gray { background: #eee; color: #666; padding: 4rpx 14rpx; border-radius: 16rpx; font-size: 22rpx; }

.modal-section {
  background: #fff; border-radius: 16rpx;
  padding: 24rpx; margin-top: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.modal-section-title { font-size: 28rpx; font-weight: 600; color: #b71c1c; margin-bottom: 12rpx; }
.modal-section-body { font-size: 26rpx; color: #555; line-height: 1.8; white-space: pre-wrap; }

.modal-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.action-btn {
  flex: 1; text-align: center;
  background: #fff5f5; color: #b71c1c;
  border: 2rpx solid #fbe9e7; border-radius: 48rpx;
  padding: 18rpx; font-size: 28rpx;
}

.share-btn {
  flex: 1;
  background: #fff5f5; color: #b71c1c;
  border: 2rpx solid #fbe9e7; border-radius: 48rpx;
  font-size: 28rpx; padding: 18rpx;
}
.share-btn::after { border: none; }

.poster-btn {
  display: block; width: 100%; margin-top: 16rpx;
  background: linear-gradient(135deg, #ffd54f, #fbc02d); color: #5d4037;
  border-radius: 48rpx; padding: 18rpx;
  font-size: 28rpx;
}
.poster-btn::after { border: none; }

.modal-close {
  position: absolute; bottom: 24rpx; left: 24rpx; right: 24rpx;
  background: #fff; color: #b71c1c; text-align: center;
  padding: 22rpx; border-radius: 48rpx; border: 2rpx solid #b71c1c;
  font-size: 28rpx;
}