.container { padding: 0 0 40rpx; min-height: 100vh; background: #fafafa; }
.container.splash { overflow: hidden; height: 100vh; }

/* 启动动画 */
.splash-mask {
  position: fixed; inset: 0;
  background: linear-gradient(135deg, #b71c1c, #d32f2f 70%, #f57c00);
  display: flex; align-items: center; justify-content: center; flex-direction: column;
  z-index: 9999; color: #fff;
  animation: splashFade 0.5s ease;
}
@keyframes splashFade {
  from { opacity: 0; }
  to { opacity: 1; }
}
.splash-logo {
  font-size: 120rpx; background: rgba(255,255,255,0.2); width: 200rpx; height: 200rpx;
  border-radius: 50%; line-height: 200rpx; text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.18);
  animation: pulse 1.4s ease infinite;
}
@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.06); }
  100% { transform: scale(1); }
}
.splash-text { font-size: 38rpx; font-weight: 700; margin-top: 32rpx; letter-spacing: 4rpx; }
.splash-sub { font-size: 22rpx; opacity: 0.85; margin-top: 8rpx; letter-spacing: 6rpx; }
.splash-spinner {
  margin-top: 64rpx;
  width: 48rpx; height: 48rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* 顶部轮播 */
.top-banner { width: 100%; height: 360rpx; }
.banner-cover { width: 100%; height: 100%; padding: 40rpx 24rpx 32rpx; color: #fff; box-sizing: border-box; border-bottom-left-radius: 24rpx; border-bottom-right-radius: 24rpx; position: relative; overflow: hidden; }
.banner-cover::before { content: ''; position: absolute; right: -40rpx; top: -40rpx; width: 200rpx; height: 200rpx; background: rgba(255,255,255,0.1); border-radius: 50%; }
.banner-cover::after { content: ''; position: absolute; left: -40rpx; bottom: -80rpx; width: 280rpx; height: 280rpx; background: rgba(255,255,255,0.08); border-radius: 50%; }

.banner-row { display: flex; justify-content: space-between; align-items: flex-start; position: relative; z-index: 1; }
.banner-title { display: block; font-size: 36rpx; font-weight: 700; }
.banner-sub { display: block; font-size: 24rpx; opacity: 0.9; margin-top: 6rpx; }
.banner-greet { font-size: 24rpx; opacity: 0.85; }
.countdown-row {
  display: flex; align-items: baseline;
  margin-top: 20rpx; position: relative; z-index: 1;
}
.cd-num { font-size: 80rpx; font-weight: 800; line-height: 1; color: #fff8e1; margin-right: 12rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15); }
.cd-label { font-size: 26rpx; opacity: 0.9; }
.banner-meta {
  display: flex; gap: 20rpx; margin-top: 16rpx;
  font-size: 22rpx; opacity: 0.85; position: relative; z-index: 1;
}
.banner-meta text { background: rgba(255,255,255,0.18); padding: 4rpx 16rpx; border-radius: 24rpx; }

/* 骨架屏 */
.skeleton-wrap { padding: 24rpx; }
.sk-card {
  height: 220rpx; border-radius: 16rpx;
  background: linear-gradient(90deg, #eee, #f5f5f5, #eee);
  background-size: 200% 100%;
  margin-bottom: 24rpx;
  animation: shimmer 1.4s infinite;
}
.sk-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-bottom: 24rpx; }
.sk-item { width: 96rpx; height: 96rpx; margin: 0 auto; border-radius: 16rpx; background: linear-gradient(90deg, #eee, #f5f5f5, #eee); background-size: 200% 100%; animation: shimmer 1.4s infinite; }
@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

.card { background: #fff; margin: 24rpx; padding: 28rpx; border-radius: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.card-title { font-size: 30rpx; font-weight: 600; }

.flex-between { display: flex; justify-content: space-between; align-items: center; }
.more-btn { color: #b71c1c; font-size: 26rpx; }

.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  padding: 20rpx 16rpx;
}
.grid-item {
  display: flex; flex-direction: column; align-items: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
}
.grid-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
  background: linear-gradient(135deg, #fff5f5, #fff8e1);
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.grid-name { font-size: 24rpx; color: #555; }
.grid-hover { background: #fff5f5; transform: scale(0.95); transition: transform 0.15s; }

/* 天气 */
.weather-card { background: linear-gradient(135deg, #ffecb3, #ffe0b2); margin: 24rpx; padding: 24rpx; border-radius: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.weather-head { display: flex; justify-content: space-between; align-items: center; }
.weather-mini { font-size: 24rpx; color: #d84315; font-weight: 600; }
.weather-row { display: flex; align-items: center; gap: 24rpx; margin-top: 12rpx; }
.weather-temp { font-size: 64rpx; font-weight: 800; color: #d84315; line-height: 1; }
.weather-info { font-size: 28rpx; }
.mt8 { margin-top: 12rpx; }

/* 小兰发布 */
.pub-item { padding: 16rpx 8rpx; border-bottom: 1rpx dashed #eee; border-radius: 8rpx; transition: background 0.15s; }
.pub-item:last-child { border-bottom: none; }
.pub-hover { background: #fafafa; }
.pub-title { font-size: 28rpx; font-weight: 500; }

/* 跑者故事 */
.story-row { display: flex; padding: 16rpx 0; border-bottom: 1rpx dashed #eee; align-items: flex-start; }
.story-row:last-child { border-bottom: none; }
.card-hover { transform: scale(0.99); transition: transform 0.15s; }
.story-thumb { width: 160rpx; height: 160rpx; border-radius: 12rpx; background: #f0f0f0; flex-shrink: 0; }
.story-thumb.fallback { display:flex; align-items:center; justify-content:center; font-size: 48rpx; }
.story-content { flex: 1; margin-left: 16rpx; overflow: hidden; }
.story-title { font-size: 28rpx; font-weight: 500; }
.story-meta { margin-top: 4rpx; }
.story-text {
  font-size: 24rpx; color: #888; margin-top: 6rpx; line-height: 1.5;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}

.publish-cta {
  margin-top: 16rpx; padding: 16rpx;
  text-align: center;
  background: linear-gradient(135deg, #fff5f5, #fff8e1);
  color: #b71c1c; border-radius: 12rpx; border: 2rpx dashed #fbe9e7;
  font-size: 26rpx;
}
.btn-hover { transform: scale(0.97); transition: transform 0.15s; }

/* 个性化推荐 - mini grid */
.mini-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-top: 12rpx; }
.mini-item { display: flex; flex-direction: column; align-items: center; }
.mini-img { width: 100%; height: 140rpx; border-radius: 12rpx; background: #f0f0f0; }
.mini-img.fallback { display:flex; align-items:center; justify-content:center; font-size: 56rpx; color: #b71c1c; background: #fff5f5; }
.mini-title { font-size: 22rpx; color: #555; margin-top: 6rpx; text-align: center; line-height: 1.4;
  display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; width: 100%; }

.footer { text-align: center; padding: 40rpx 0 24rpx; color: #999; font-size: 24rpx; }