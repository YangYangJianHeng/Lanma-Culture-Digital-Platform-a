.page {
  padding: 24rpx 24rpx 160rpx;
  min-height: 100vh;
  background: #f5f5f5;
}
.form-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-row-multi {
  flex-direction: column;
  align-items: stretch;
}
.form-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.required {
  color: #b71c1c;
  margin-left: 4rpx;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding: 0 12rpx;
}
.form-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding: 0 12rpx;
}
.form-value.placeholder { color: #bbb; }
.form-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  padding: 12rpx 0;
  min-height: 200rpx;
}

.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx;
  border-top: 1rpx solid #eee;
}
.submit-btn {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #b71c1c 0%, #d32f2f 100%);
  color: #fff;
}
.btn-disabled { background: #ccc; }