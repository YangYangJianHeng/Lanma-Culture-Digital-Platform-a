.page {
  padding: 24rpx 24rpx 60rpx;
  min-height: 100vh;
  background: #f5f5f5;
}
.tabs {
  white-space: nowrap;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 4rpx 12rpx;
}
.tab {
  display: inline-block;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  color: #666;
}
.tab.active {
  color: #b71c1c;
  border-bottom: 4rpx solid #b71c1c;
  font-weight: 600;
}

.quick-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.quick-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #b71c1c 0%, #d32f2f 100%);
  color: #fff;
  font-weight: 600;
}
.quick-btn-ghost {
  background: #fff;
  color: #b71c1c;
  border: 1rpx solid #ffcdd2;
}
.quick-hover { opacity: 0.85; }
.quick-icon { font-size: 30rpx; margin-right: 4rpx; }

.team-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.team-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #b71c1c 0%, #f57c00 100%);
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.team-body { flex: 1; }
.team-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.team-slogan {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.team-meta {
  font-size: 22rpx;
  color: #888;
  margin-top: 8rpx;
}
.team-meta text { margin-right: 16rpx; }

.status-pill {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
}
.status-pill.pending { background: #fff3e0; color: #ef6c00; }
.status-pill.ok { background: #e8f5e9; color: #2e7d32; }
.status-pill.rejected, .status-pill.disbanded { background: #ffebee; color: #c62828; }

.rank-row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.rank-no {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  margin-right: 20rpx;
}
.rank-no.rank-top {
  background: linear-gradient(135deg, #ffd76e 0%, #f57c00 100%);
  color: #fff;
}
.rank-no.rank-normal { background: #f5f5f5; color: #666; }
.rank-body { flex: 1; }
.rank-name { font-size: 28rpx; color: #333; font-weight: 500; }
.rank-sub { font-size: 22rpx; color: #888; margin-top: 4rpx; }
.rank-score { text-align: right; }
.score-num { font-size: 32rpx; color: #b71c1c; font-weight: 700; }
.score-label { font-size: 22rpx; color: #888; }

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999;
}
.empty-icon { font-size: 96rpx; }
.empty-text { font-size: 28rpx; margin-top: 16rpx; }

.loading {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}