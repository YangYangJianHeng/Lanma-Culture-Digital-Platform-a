.page { padding: 24rpx; background: #f5f5f5; min-height: 100vh; }
.form-card { background: #fff; border-radius: 24rpx; padding: 32rpx 24rpx; }

.form-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.form-row.center { justify-content: center; border-bottom: none; padding-bottom: 8rpx; }
.form-label { width: 160rpx; font-size: 28rpx; color: #555; }
.form-input { flex: 1; font-size: 28rpx; }

.avatar-edit { width: 160rpx; height: 160rpx; position: relative; }
.avatar-img { width: 160rpx; height: 160rpx; border-radius: 50%; background: #f0f0f0; }
.avatar-fallback {
  display: flex; align-items: center; justify-content: center;
  background: #fff5f5; color: #b71c1c; font-size: 28rpx; border: 2rpx dashed #b71c1c;
}
.camera-tag {
  position: absolute; right: 0; bottom: 0;
  background: #b71c1c; color: #fff;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx;
}

.radio-group { display: flex; }
.radio-item { display: flex; align-items: center; margin-right: 24rpx; font-size: 28rpx; }
.radio-item radio { transform: scale(0.85); margin-right: 8rpx; }