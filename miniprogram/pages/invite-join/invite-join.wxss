.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f5f5;
}
.hero {
  text-align: center;
  padding: 40rpx 24rpx;
  background: linear-gradient(135deg, #b71c1c 0%, #f57c00 100%);
  border-radius: 16rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.hero-icon {
  font-size: 80rpx;
}
.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 8rpx;
}
.hero-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.code-input-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.code-input {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: #b71c1c;
  text-align: center;
  padding: 24rpx;
  background: #fff5f5;
  border-radius: 12rpx;
  letter-spacing: 4rpx;
  font-family: monospace;
}
.scan-btn {
  font-size: 24rpx;
  background: #b71c1c;
  color: #fff;
  padding: 0 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn {
  text-align: center;
  font-size: 28rpx;
  padding: 22rpx 0;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #b71c1c 0%, #d32f2f 100%);
  color: #fff;
  font-weight: 600;
}
.btn-disabled { background: #ccc; }

.error-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #c62828;
  background: #ffebee;
  padding: 12rpx;
  border-radius: 8rpx;
}

.result-row {
  display: flex;
  padding: 10rpx 0;
  font-size: 26rpx;
}
.result-row .lbl {
  color: #999;
  width: 160rpx;
}
.result-row .val {
  color: #333;
  flex: 1;
}

.success-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #2e7d32;
  background: #e8f5e9;
  padding: 12rpx;
  border-radius: 8rpx;
}
.warn-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #ef6c00;
  background: #fff3e0;
  padding: 12rpx;
  border-radius: 8rpx;
}

.result-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 18rpx 0;
  border-radius: 12rpx;
}
.btn-ghost { background: #f5f5f5; color: #333; }
.btn-primary { background: #b71c1c; color: #fff; font-weight: 600; }

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #999;
  margin-top: 40rpx;
}