.page { display: flex; flex-direction: column; height: 100vh; background: #f5f5f5; }

/* 顶部 */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #b71c1c, #d32f2f);
  color: #fff;
}
.model-chip {
  display: flex; align-items: center;
  background: rgba(255,255,255,0.18);
  padding: 10rpx 20rpx; border-radius: 30rpx;
  font-size: 24rpx;
}
.model-chip .dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #4caf50; box-shadow: 0 0 8rpx #4caf50;
  margin-right: 8rpx;
}
.model-chip .caret { margin-left: 8rpx; opacity: 0.8; }
.topbar-actions { display: flex; gap: 8rpx; }
.icon-btn {
  width: 60rpx; height: 60rpx; line-height: 60rpx; text-align: center;
  background: rgba(255,255,255,0.18); border-radius: 50%;
  font-size: 28rpx;
}
.btn-hover { background: rgba(255,255,255,0.3); transform: scale(0.95); }

/* 模型选择弹层 */
.model-picker-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 998;
  display: flex; align-items: center; justify-content: center;
  animation: fadeIn 0.18s ease;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.model-picker {
  width: 80%; background: #fff; border-radius: 20rpx; padding: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,0.15);
  animation: scaleUp 0.2s ease;
}
@keyframes scaleUp { from { transform: scale(0.92); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.mp-title { font-size: 30rpx; font-weight: 600; text-align: center; margin-bottom: 16rpx; }
.mp-item {
  display: flex; align-items: center;
  padding: 20rpx 24rpx; border-radius: 12rpx;
  font-size: 28rpx; color: #333;
}
.mp-item.active { background: #fff5f5; color: #b71c1c; }
.mp-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%; background: #ddd;
  margin-right: 12rpx;
}
.mp-item.active .mp-dot { background: #b71c1c; }

/* 聊天 */
.chat-scroll { flex: 1; height: 0; padding: 24rpx 24rpx 0; }
.msg-row { display: flex; margin-bottom: 28rpx; align-items: flex-start; }
.row-right { flex-direction: row-reverse; }
.row-left { flex-direction: row; }

.avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 600; color: #fff;
}
.avatar-ai { background: linear-gradient(135deg, #b71c1c, #d32f2f); }
.avatar-user { background: linear-gradient(135deg, #1976d2, #42a5f5); }

.bubble-wrap { max-width: 70%; margin: 0 16rpx; }
.bubble {
  padding: 18rpx 24rpx; border-radius: 24rpx;
  font-size: 28rpx; line-height: 1.7; white-space: pre-wrap;
  word-break: break-word;
}
.bubble-ai { background: #fff; color: #333; border-top-left-radius: 6rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.bubble-user { background: #b71c1c; color: #fff; border-top-right-radius: 6rpx; }

.bubble-foot {
  display: flex; gap: 8rpx; flex-wrap: wrap;
  margin-top: 6rpx; padding: 0 8rpx;
}
.row-right .bubble-foot { justify-content: flex-end; }
.bubble-time { font-size: 20rpx; color: #999; }
.src-tag { font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 8rpx; }
.src-ollama { background: #e8f5e9; color: #2e7d32; }
.src-fallback { background: #fff3c4; color: #b71c1c; }

.dots { display: flex; align-items: center; gap: 8rpx; padding: 6rpx 0; }
.dot {
  width: 12rpx; height: 12rpx; border-radius: 50%; background: #ccc;
  animation: blink 1.4s infinite;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink { 0%, 60%, 100% { opacity: 0.3; transform: scale(0.85); } 30% { opacity: 1; transform: scale(1); } }

/* 输入区 */
.composer {
  background: #fff;
  border-top: 1rpx solid #eee;
  padding: 16rpx 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx);
}
.quick-row { white-space: nowrap; padding-bottom: 12rpx; }
.quick-chip {
  display: inline-block;
  font-size: 24rpx; background: #fff5f5; color: #b71c1c;
  padding: 8rpx 20rpx; border-radius: 24rpx; margin-right: 12rpx;
  flex-shrink: 0;
}
.input-row { display: flex; align-items: flex-end; }
.input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  min-height: 40rpx;
  max-height: 240rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.send-btn {
  margin-left: 16rpx;
  background: #b71c1c; color: #fff;
  padding: 16rpx 32rpx; border-radius: 36rpx;
  font-size: 28rpx;
}
.send-disabled { background: #ccc; }
.hint { font-size: 22rpx; text-align: center; padding-top: 4rpx; }

/* 会话标题 */
.session-title { padding: 8rpx 24rpx; background: #fff; border-bottom: 1rpx solid #f0f0f0; }
.session-count { font-size: 22rpx; color: #999; }

/* 会话抽屉 */
.drawer-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 999; animation: fadeIn 0.2s; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.drawer {
  position: absolute; left: 0; top: 0; bottom: 0;
  width: 70%;
  background: #fff;
  display: flex; flex-direction: column;
  animation: slideIn 0.25s ease;
  box-shadow: 4rpx 0 24rpx rgba(0,0,0,0.12);
}
@keyframes slideIn { from { transform: translateX(-100%); } to { transform: translateX(0); } }
.drawer-head {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.drawer-title { font-size: 32rpx; font-weight: 700; color: #b71c1c; }
.drawer-new {
  background: linear-gradient(135deg, #b71c1c, #d32f2f); color: #fff;
  padding: 8rpx 20rpx; border-radius: 32rpx; font-size: 24rpx;
}
.btn-hover { transform: scale(0.96); transition: transform 0.15s; }
.drawer-scroll { flex: 1; padding: 16rpx; }
.sess {
  display: flex; align-items: center;
  padding: 20rpx 16rpx; border-radius: 12rpx;
  margin-bottom: 12rpx;
  background: #fafafa;
  transition: background 0.15s;
}
.sess.active { background: linear-gradient(135deg, #fff5f5, #fff8e1); border: 2rpx solid #fbe9e7; }
.sess-hover { background: #f0f0f0; }
.sess-body { flex: 1; min-width: 0; }
.sess-title { font-size: 28rpx; font-weight: 500; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sess-flag { color: #b71c1c; margin-right: 6rpx; }
.sess-meta { margin-top: 4rpx; }
.sess-actions { display: flex; gap: 8rpx; margin-left: 12rpx; flex-shrink: 0; }
.sess-act { padding: 8rpx; font-size: 24rpx; }
.sess-act-del { color: #b71c1c; }

/* 重命名弹层 */
.rename-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.rename-box {
  width: 80%; background: #fff; border-radius: 16rpx;
  padding: 32rpx 24rpx;
}
.rename-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.rename-input {
  background: #f7f7f7; padding: 20rpx 24rpx; border-radius: 12rpx;
  font-size: 28rpx;
}
.rename-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.rename-cancel, .rename-ok {
  flex: 1; text-align: center; padding: 18rpx; border-radius: 48rpx; font-size: 28rpx;
}
.rename-cancel { background: #f5f5f5; color: #666; }
.rename-ok { background: linear-gradient(135deg, #b71c1c, #d32f2f); color: #fff; }

.empty { text-align: center; padding: 40rpx 0; color: #aaa; font-size: 26rpx; }