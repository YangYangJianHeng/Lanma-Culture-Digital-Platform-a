.page { padding: 24rpx; background: #f5f5f5; min-height: 100vh; padding-bottom: 60rpx; }

.cat-row-wrap { display: flex; align-items: center; gap: 12rpx; padding-bottom: 16rpx; }
.cat-row { white-space: nowrap; flex: 1; }
.cat-chip { display: inline-block; padding: 10rpx 24rpx; background: #fff; color: #666; border-radius: 32rpx; font-size: 26rpx; margin-right: 12rpx; flex-shrink: 0; }
.cat-chip.active { background: linear-gradient(135deg, #b71c1c, #d32f2f); color: #fff; }

.fav-btn {
  background: #fff5f5; color: #b71c1c;
  border: 2rpx solid #fbe9e7;
  padding: 10rpx 20rpx; border-radius: 32rpx; font-size: 24rpx;
  flex-shrink: 0;
}
.fav-btn.active { background: #b71c1c; color: #fff; border-color: #b71c1c; }

.view-toggle {
  background: #fff; color: #666; border: 2rpx solid #eee;
  padding: 10rpx 20rpx; border-radius: 32rpx; font-size: 24rpx;
  flex-shrink: 0;
}
.view-toggle.active { background: #1976d2; color: #fff; border-color: #1976d2; }

/* 列表 */
.list { display: flex; flex-direction: column; gap: 20rpx; }
.lm-card { display: flex; padding: 20rpx; }
.card-hover { transform: scale(0.99); transition: transform 0.15s; }
.lm-cover { width: 220rpx; height: 160rpx; border-radius: 12rpx; background: #eee; flex-shrink: 0; }
.fallback { display:flex; align-items:center; justify-content:center; font-size: 72rpx; color: #b71c1c; background:#fff5f5; }
.lm-body { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.lm-head { display: flex; justify-content: space-between; align-items: center; }
.lm-name { font-size: 30rpx; font-weight: 600; }
.km-tag { color: #b71c1c; font-size: 22rpx; background: #fff5f5; padding: 2rpx 12rpx; border-radius: 8rpx; }
.lm-meta { margin: 8rpx 0; display: flex; gap: 12rpx; }
.lm-meta .tag { font-size: 22rpx; }
.tag-check { background: #e8f5e9; color: #2e7d32; padding: 2rpx 12rpx; border-radius: 8rpx; font-size: 22rpx; }
.lm-desc {
  font-size: 24rpx; color: #666; line-height: 1.5;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.lm-foot { display: flex; gap: 16rpx; margin-top: 8rpx; }
.audio-tag { font-size: 22rpx; color: #888; background: #f0f0f0; padding: 2rpx 12rpx; border-radius: 8rpx; }

.empty { text-align: center; padding: 100rpx 0; color: #aaa; font-size: 26rpx; }
.empty-icon { font-size: 96rpx; opacity: 0.6; margin-bottom: 12rpx; }

/* 地图视图 */
.map-view {
  position: relative; height: 70vh; min-height: 800rpx;
  border-radius: 24rpx; overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}
.lm-map { width: 100%; height: 100%; }
.map-overlay-top {
  position: absolute; top: 24rpx; left: 24rpx; right: 24rpx;
  display: flex; justify-content: space-between;
  pointer-events: none;
}
.map-tag {
  background: rgba(255,255,255,0.95);
  padding: 8rpx 20rpx; border-radius: 32rpx;
  font-size: 22rpx; color: #b71c1c;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.map-bottom-sheet {
  position: absolute; left: 0; right: 0; bottom: 0;
  background: #fff; border-top-left-radius: 24rpx; border-top-right-radius: 24rpx;
  box-shadow: 0 -8rpx 24rpx rgba(0,0,0,0.08);
  transition: transform 0.25s ease;
  max-height: 60%;
}
.map-bottom-sheet.expanded { max-height: 80%; }
.sheet-handle {
  text-align: center; padding: 16rpx 0;
}
.sheet-handle-bar {
  display: inline-block; width: 80rpx; height: 8rpx;
  background: #e0e0e0; border-radius: 4rpx;
}

.sheet-active {
  display: flex; flex-direction: column;
  padding: 16rpx 24rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.sheet-cover {
  width: 100%; height: 280rpx; border-radius: 16rpx;
  background: #f0f0f0; margin-bottom: 16rpx;
}
.sheet-name { font-size: 32rpx; font-weight: 700; color: #222; }
.sheet-meta { margin-top: 8rpx; }
.sheet-desc {
  font-size: 24rpx; color: #666; margin-top: 8rpx; line-height: 1.5;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.sheet-actions {
  display: flex; gap: 16rpx; margin-top: 16rpx;
}
.sheet-btn {
  flex: 1; text-align: center;
  background: #f5f5f5; color: #666;
  padding: 16rpx; border-radius: 48rpx;
  font-size: 26rpx;
}
.sheet-btn-primary {
  background: linear-gradient(135deg, #b71c1c, #d32f2f);
  color: #fff;
}

.sheet-list {
  height: 50vh; padding: 8rpx 16rpx;
}
.sheet-item {
  display: flex; align-items: center; padding: 16rpx;
  border-radius: 16rpx;
  transition: background 0.15s;
}
.sheet-item.active { background: linear-gradient(135deg, #fff5f5, #fff8e1); }
.sheet-item-hover { background: #f0f0f0; }
.sheet-item-cover {
  width: 96rpx; height: 96rpx; border-radius: 12rpx;
  background: #f0f0f0; flex-shrink: 0;
}
.sheet-item-cover.fallback { font-size: 40rpx; }
.sheet-item-info { flex: 1; margin-left: 16rpx; min-width: 0; }
.sheet-item-name { font-size: 28rpx; font-weight: 500; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sheet-item-meta { margin-top: 4rpx; }
.sheet-item-check {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #4caf50; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700;
}

/* 详情 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 999; display: flex; align-items: flex-end; animation: fadeIn 0.2s ease; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.modal {
  width: 100%; max-height: 88vh;
  background: #fafafa; border-top-left-radius: 28rpx; border-top-right-radius: 28rpx;
  overflow-y: auto; position: relative;
  animation: slideUp 0.25s ease;
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
.modal-img { display: block; width: 100%; height: 400rpx; background: #eee; }
.modal-img.fallback { display:flex; align-items: center; justify-content: center; font-size: 120rpx; color: #b71c1c; background: #fff5f5; }
.modal-body { padding: 24rpx 24rpx 160rpx; }
.modal-title { font-size: 38rpx; font-weight: 700; }
.modal-meta { display: flex; gap: 16rpx; align-items: center; margin: 12rpx 0; }
.modal-desc { font-size: 28rpx; color: #555; line-height: 1.8; margin-top: 16rpx; white-space: pre-wrap; }

.modal-actions { display: flex; gap: 16rpx; margin-top: 20rpx; flex-wrap: wrap; }
.action-btn {
  flex: 1; min-width: 200rpx; text-align: center;
  background: #fff5f5; color: #b71c1c;
  border: 2rpx solid #fbe9e7; border-radius: 48rpx;
  padding: 16rpx; font-size: 26rpx;
}
.action-btn.playing { background: #b71c1c; color: #fff; }

.map-btn-big {
  display: block; text-align: center;
  background: linear-gradient(135deg, #b71c1c, #d32f2f);
  color: #fff; padding: 22rpx; border-radius: 48rpx;
  margin-top: 16rpx; font-size: 28rpx;
}

.fav-toggle {
  flex: 1; text-align: center;
  background: #fff5f5; color: #b71c1c;
  border: 2rpx solid #fbe9e7; border-radius: 48rpx;
  padding: 18rpx; font-size: 28rpx;
}
.fav-toggle.active { background: #b71c1c; color: #fff; border-color: #b71c1c; }

.checkin-btn {
  flex: 1; text-align: center;
  background: #fff; color: #4caf50;
  border: 2rpx solid #c8e6c9; border-radius: 48rpx;
  padding: 18rpx; font-size: 28rpx;
}
.checkin-btn.checked { background: #4caf50; color: #fff; border-color: #4caf50; }

.share-btn {
  flex: 1; background: #fff; border: 2rpx solid #fbe9e7; color: #b71c1c;
  border-radius: 48rpx; padding: 18rpx; font-size: 28rpx;
}
.share-btn::after { border: none; }
.poster-btn {
  flex: 1; background: linear-gradient(135deg, #fff5f5, #fff8e1);
  border: 2rpx solid #fbe9e7; color: #b71c1c;
  border-radius: 48rpx; padding: 18rpx; font-size: 28rpx; text-align: center;
}

.modal-close {
  position: absolute; bottom: 24rpx; left: 24rpx; right: 24rpx;
  background: #fff; color: #b71c1c; text-align: center;
  padding: 20rpx; border-radius: 48rpx; border: 2rpx solid #b71c1c;
  font-size: 28rpx;
}