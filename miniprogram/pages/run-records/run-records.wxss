.page {
  padding: 24rpx 24rpx 140rpx;
  min-height: 100vh;
  background: #f5f5f5;
}
.stats-card {
  background: linear-gradient(135deg, #b71c1c 0%, #f57c00 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  color: #fff;
  margin-bottom: 24rpx;
}
.stat { flex: 1; text-align: center; }
.stat-num {
  font-size: 48rpx;
  font-weight: 700;
}
.stat-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.tabs {
  white-space: nowrap;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 4rpx 12rpx;
}
.tab {
  display: inline-block;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  color: #666;
}
.tab.active {
  color: #b71c1c;
  border-bottom: 4rpx solid #b71c1c;
  font-weight: 600;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999;
}
.empty-icon { font-size: 96rpx; }
.empty-text { font-size: 28rpx; margin-top: 16rpx; color: #555; }
.empty-tip { font-size: 24rpx; margin-top: 8rpx; }

.record-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.record-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.record-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.record-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.record-del {
  font-size: 22rpx;
  color: #ff7676;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #ffebee;
}

.record-stats {
  display: flex;
  justify-content: space-around;
  background: #fafafa;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.stat-block { text-align: center; }
.stat-block .num {
  font-size: 36rpx;
  font-weight: 700;
  color: #b71c1c;
}
.stat-block .lbl {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.record-loc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.record-note {
  font-size: 24rpx;
  color: #555;
  background: #fafafa;
  padding: 12rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}
.record-stats2 {
  font-size: 22rpx;
  color: #999;
}
.record-stats2 text { margin-right: 16rpx; }

.fab {
  position: fixed;
  right: 36rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #b71c1c 0%, #d32f2f 100%);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(183, 28, 28, 0.4);
  z-index: 99;
}
.fab-hover { transform: scale(0.95); }

.loading {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}

.sheet-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  background: #fff;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx 60rpx;
  max-height: 80vh;
  overflow-y: auto;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-label {
  width: 180rpx;
  font-size: 26rpx;
  color: #333;
}
.required { color: #b71c1c; margin-left: 4rpx; }
.form-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  padding: 0 12rpx;
}
.form-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  padding: 0 12rpx;
}
.form-value.placeholder { color: #bbb; }

.sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 12rpx;
}
.btn-ghost { background: #f5f5f5; color: #333; }
.btn-primary { background: #b71c1c; color: #fff; font-weight: 600; }
.btn-disabled { background: #ccc; }