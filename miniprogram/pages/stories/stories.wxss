.page { padding: 24rpx 24rpx 180rpx; min-height: 100vh; background: #f5f5f5; }

/* 置顶 banner */
.pinned-swiper { width: 100%; height: 360rpx; border-radius: 20rpx; overflow: hidden; box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.08); }
.pinned-card {
  position: relative; overflow: hidden;
  height: 360rpx;
}
.pinned-img { position: absolute; inset: 0; width: 100%; height: 100%; }
.pinned-fallback {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  font-size: 120rpx; color: #b71c1c; background: linear-gradient(135deg, #fff5f5, #fff8e1);
}
.pinned-mask {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 30%, rgba(0,0,0,0.7));
}
.pinned-content {
  position: absolute; left: 24rpx; right: 24rpx; bottom: 24rpx;
  color: #fff; z-index: 1;
}
.pinned-badge {
  display: inline-block; padding: 4rpx 14rpx;
  background: linear-gradient(135deg, #ff7043, #f4511e);
  border-radius: 16rpx; font-size: 22rpx; margin-bottom: 12rpx;
}
.pinned-title {
  font-size: 32rpx; font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4);
  display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
}
.pinned-meta { font-size: 22rpx; opacity: 0.9; margin-top: 6rpx; }

/* 热门话题 */
.topics {
  display: flex; gap: 12rpx; overflow-x: auto;
  padding: 16rpx 0 12rpx; white-space: nowrap;
  scrollbar-width: none;
}
.topics::-webkit-scrollbar { display: none; }
.topic-chip {
  display: inline-flex; align-items: center; gap: 8rpx;
  background: #fff; color: #555;
  padding: 12rpx 20rpx; border-radius: 32rpx;
  font-size: 24rpx; flex-shrink: 0;
  border: 2rpx solid transparent;
}
.topic-chip.active { background: linear-gradient(135deg, #fff5f5, #fff8e1); color: #b71c1c; border-color: #fbe9e7; }
.topic-hover { transform: scale(0.95); transition: transform 0.15s; }
.topic-icon { font-size: 28rpx; }

/* 搜索 */
.search-row { display: flex; align-items: center; gap: 12rpx; padding: 8rpx 0; }
.search-input-wrap {
  flex: 1;
  display: flex; align-items: center;
  background: #fff; border-radius: 48rpx;
  padding: 0 16rpx; height: 72rpx;
}
.search-icon { font-size: 28rpx; color: #999; margin-right: 8rpx; }
.search-input { flex: 1; font-size: 26rpx; }
.search-clear { padding: 4rpx 12rpx; color: #999; font-size: 26rpx; }

.sort-chip {
  background: #fff; padding: 16rpx 20rpx; border-radius: 32rpx;
  font-size: 24rpx; color: #b71c1c; display: flex; align-items: center; gap: 4rpx;
}
.sort-chip .caret { font-size: 20rpx; opacity: 0.7; }

/* 年份 */
.year-row { white-space: nowrap; padding: 16rpx 0; }
.year-chip {
  display: inline-block; padding: 8rpx 20rpx;
  background: #fff; color: #666; border-radius: 24rpx;
  font-size: 24rpx; margin-right: 12rpx; flex-shrink: 0;
}
.year-chip.active { background: linear-gradient(135deg, #b71c1c, #d32f2f); color: #fff; }

/* 卡片 */
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.card-hover { transform: scale(0.99); transition: transform 0.15s; }

/* 故事卡片 */
.story-card { padding: 24rpx; }
.story-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.author-info { display: flex; align-items: center; gap: 12rpx; }
.author-avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background-color: #fbe9e7; background-size: cover; background-position: center;
  display: flex; align-items: center; justify-content: center;
  color: #b71c1c; font-weight: 600; font-size: 26rpx;
}
.author-fallback { background: linear-gradient(135deg, #b71c1c, #d32f2f); color: #fff; }
.author-name { font-size: 26rpx; font-weight: 500; }
.bib { font-size: 22rpx; color: #b71c1c; background: #fff5f5; padding: 4rpx 12rpx; border-radius: 8rpx; }

.story-title { font-size: 30rpx; font-weight: 600; line-height: 1.4; margin-bottom: 8rpx; }
.story-content {
  font-size: 26rpx; color: #666; line-height: 1.6;
  display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
}
.story-cover {
  width: 100%; height: 360rpx; border-radius: 12rpx;
  margin-top: 16rpx; background: #f0f0f0;
}
.story-foot {
  display: flex; gap: 24rpx; margin-top: 16rpx; padding-top: 12rpx;
  border-top: 1rpx dashed #f0f0f0;
}
.foot-stat { font-size: 22rpx; color: #888; }

/* 空态 */
.empty-state { text-align: center; padding: 100rpx 0 60rpx; }
.empty-icon { font-size: 120rpx; opacity: 0.6; margin-bottom: 20rpx; }
.empty-title { font-size: 32rpx; color: #666; font-weight: 500; }
.empty-sub { font-size: 24rpx; margin-top: 12rpx; }
.empty-cta {
  display: inline-block; margin-top: 32rpx;
  background: linear-gradient(135deg, #b71c1c, #d32f2f); color: #fff;
  padding: 16rpx 40rpx; border-radius: 48rpx; font-size: 28rpx;
}
.btn-hover { transform: scale(0.96); transition: transform 0.15s; }

/* 加载状态 */
.loading-more { text-align: center; padding: 24rpx 0; }

/* 浮动按钮 */
.fab-group {
  position: fixed; right: 32rpx; bottom: 80rpx;
  display: flex; flex-direction: column; gap: 20rpx; z-index: 99;
}
.fab {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.2);
}
.fab-primary { background: linear-gradient(135deg, #b71c1c, #d32f2f); }
.fab-secondary { background: linear-gradient(135deg, #1976d2, #42a5f5); }
.fab-hover { transform: scale(0.92); transition: transform 0.15s; }