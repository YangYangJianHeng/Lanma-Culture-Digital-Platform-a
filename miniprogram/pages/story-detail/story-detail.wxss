.page { padding: 24rpx; padding-bottom: 200rpx; min-height: 100vh; background: #f5f5f5; }
.header { padding: 32rpx 24rpx; }
.head { display: flex; align-items: center; }
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #f0f0f0; }
.avatar-fallback { display:flex;align-items:center;justify-content:center; background: linear-gradient(135deg, #b71c1c, #d32f2f); color: #fff; font-weight: 600; }
.meta { flex: 1; margin-left: 16rpx; }
.author { font-size: 28rpx; font-weight: 500; }

.head-actions { display: flex; gap: 12rpx; }
.icon-btn {
  width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center;
  background: #f5f5f5; border-radius: 50%; font-size: 26rpx;
}
.btn-hover { transform: scale(0.95); transition: transform 0.15s; }

.title { font-size: 38rpx; font-weight: 700; margin-top: 24rpx; line-height: 1.4; }
.content { font-size: 28rpx; color: #444; line-height: 1.85; margin-top: 16rpx; white-space: pre-wrap; }

.images { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 24rpx; }
.story-img { width: 100%; height: 200rpx; border-radius: 12rpx; background:#eee; }

.info { margin-top: 24rpx; display: flex; gap: 12rpx; flex-wrap: wrap; }

.actions { display: flex; align-items: center; gap: 16rpx; margin-top: 32rpx; padding-top: 24rpx; border-top: 1rpx solid #f0f0f0; }
.action-btn {
  display: inline-flex; align-items: center;
  padding: 12rpx 24rpx; border-radius: 32rpx;
  background: #fff5f5; color: #b71c1c; font-size: 26rpx;
}
.action-btn .ico { margin-right: 8rpx; font-size: 30rpx; }
.action-btn.liked { background: #b71c1c; color: #fff; }
.share-btn {
  background: #fff; border: 2rpx solid #fbe9e7; color: #b71c1c;
  font-size: 26rpx; line-height: 1.6;
  padding: 10rpx 24rpx; border-radius: 32rpx;
}
.share-btn::after { border: none; }
.share-btn .ico { margin-right: 8rpx; }

.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx; display: flex; align-items: center; }
.cmt-count { color: #999; font-weight: normal; font-size: 26rpx; margin-left: 8rpx; }

.comment {
  display: flex; padding: 16rpx 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.comment:last-child { border-bottom: none; }
.comment-hover { background: #fafafa; }
.c-avatar { width: 56rpx; height: 56rpx; border-radius: 50%; background: #f0f0f0; flex-shrink: 0; }
.c-fallback { display:flex; align-items:center; justify-content:center; background: linear-gradient(135deg, #b71c1c, #d32f2f); color: #fff; font-size: 26rpx; font-weight:600; }
.c-body { flex: 1; margin-left: 16rpx; }
.c-name { font-size: 26rpx; color: #b71c1c; font-weight: 500; }
.me-tag {
  margin-left: 8rpx;
  background: #b71c1c; color: #fff;
  padding: 2rpx 10rpx; border-radius: 8rpx; font-size: 20rpx;
  font-weight: normal;
}
.c-text { font-size: 28rpx; color: #333; margin-top: 6rpx; line-height: 1.6; }
.c-time { margin-top: 6rpx; }

.empty { text-align: center; padding: 60rpx 0; color: #aaa; font-size: 26rpx; }
.empty-icon { font-size: 80rpx; opacity: 0.6; margin-bottom: 12rpx; }

.composer {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  display: flex; align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx);
  border-top: 1rpx solid #eee;
  z-index: 100;
}
.composer-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
}
.composer-btn {
  margin-left: 16rpx;
  background: #b71c1c; color: #fff;
  border-radius: 32rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
}
.composer-btn.disabled { background: #ccc; }