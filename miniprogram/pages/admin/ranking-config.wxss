.page {
  padding: 24rpx;
  background: #0f0f0f;
  min-height: 100vh;
  color: #e5e5e5;
}
.hero {
  background: linear-gradient(135deg, #3a2a1a 0%, #1a1a1a 100%);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #3a2a1a;
}
.hero-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffd76e;
}
.hero-sub {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.card {
  background: #1a1a1a;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #2a2a2a;
}
.card-title {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #2a2a2a;
}
.form-row:last-of-type {
  border-bottom: none;
}
.form-label { flex: 1; }
.form-name { font-size: 26rpx; color: #fff; display: block; }
.form-desc { font-size: 22rpx; color: #888; margin-top: 4rpx; }
.form-input {
  background: #0a0a0a;
  border: 1rpx solid #333;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  color: #fff;
  font-size: 26rpx;
  width: 160rpx;
  text-align: right;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 18rpx;
  border-radius: 10rpx;
}
.btn-primary { background: #3a2a1a; color: #ffd76e; }
.btn-ghost { background: #2a2a2a; color: #ccc; }
.btn-hover { opacity: 0.7; }

.hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #777;
  background: #222;
  padding: 12rpx;
  border-radius: 8rpx;
}

.rank-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #2a2a2a;
}
.rank-row:last-child { border-bottom: none; }
.rank-no {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 16rpx;
  background: #2a2a2a;
  color: #aaa;
}
.rank-no.rank-top { background: #ffd76e; color: #1a1a1a; }
.rank-info { flex: 1; }
.rank-name { font-size: 28rpx; color: #fff; font-weight: 500; }
.rank-sub { font-size: 22rpx; color: #888; margin-top: 4rpx; }
.rank-score {
  text-align: right;
}
.score-num { font-size: 32rpx; color: #ffd76e; font-weight: 600; }
.score-label { font-size: 20rpx; color: #888; }

.empty-tip {
  text-align: center;
  padding: 40rpx;
  color: #777;
  font-size: 24rpx;
}