<view class="page">
  <view class="hero">
    <view class="hero-title">🏆 团队排行榜配置</view>
    <view class="hero-sub">公式:score = 跑量 × 距离权重 + (3600 / 配速) × 配速权重 + 人数 × 人数权重</view>
  </view>

  <view class="card">
    <view class="card-title">⚙ 权重配置</view>

    <view class="form-row">
      <view class="form-label">
        <text class="form-name">距离权重</text>
        <text class="form-desc">每公里跑量得分</text>
      </view>
      <input class="form-input" type="digit" data-field="weightDistance" value="{{config.weightDistance}}" bindinput="onInput" />
    </view>

    <view class="form-row">
      <view class="form-label">
        <text class="form-name">配速权重</text>
        <text class="form-desc">配速越快得分越高</text>
      </view>
      <input class="form-input" type="digit" data-field="weightPace" value="{{config.weightPace}}" bindinput="onInput" />
    </view>

    <view class="form-row">
      <view class="form-label">
        <text class="form-name">人数权重</text>
        <text class="form-desc">每名团员得分</text>
      </view>
      <input class="form-input" type="digit" data-field="weightMembers" value="{{config.weightMembers}}" bindinput="onInput" />
    </view>

    <view class="form-row">
      <view class="form-label">
        <text class="form-name">榜单条数</text>
        <text class="form-desc">默认显示前 N 名</text>
      </view>
      <input class="form-input" type="number" value="{{config.defaultLimit}}" bindinput="onLimitInput" />
    </view>

    <view class="actions">
      <view class="btn btn-ghost" bindtap="onPreview">🔄 刷新预览</view>
      <view class="btn btn-primary" bindtap="onSave" hover-class="btn-hover">💾 保存</view>
    </view>

    <view class="hint">
      当前为只读配置(修改 application.yml 的 app.team-ranking.* 节后重启后端可永久生效)
    </view>
  </view>

  <view class="card">
    <view class="card-title">📊 当前榜单预览(前 10 名)</view>
    <view wx:if="{{preview.length == 0}}" class="empty-tip">暂无数据</view>
    <view wx:for="{{preview}}" wx:key="teamId" wx:for-index="idx" class="rank-row">
      <view class="rank-no rank-{{idx+1 <= 3 ? 'top' : 'normal'}}">{{idx + 1}}</view>
      <view class="rank-info">
        <view class="rank-name">{{item.name}}</view>
        <view class="rank-sub">{{item.city || '未填写'}} · {{item.memberCount}}人 · {{item.totalDistanceKm}}km</view>
      </view>
      <view class="rank-score">
        <view class="score-num">{{item.score}}</view>
        <view class="score-label">分</view>
      </view>
    </view>
  </view>
</view>