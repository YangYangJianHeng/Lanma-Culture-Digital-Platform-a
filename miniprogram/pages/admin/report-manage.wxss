.page {
  padding: 24rpx;
  background: #0f0f0f;
  min-height: 100vh;
  color: #e5e5e5;
}
.tabs {
  white-space: nowrap;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #2a2a2a;
}
.tabs-sub {
  border-bottom: none;
  margin-bottom: 20rpx;
}
.tab {
  display: inline-block;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #888;
}
.tab.active {
  color: #ffd76e;
  border-bottom: 4rpx solid #ffd76e;
}
.tab-sub.active {
  border-bottom: none;
  color: #6dd47e;
}
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #777;
}
.empty-icon { font-size: 96rpx; }
.empty-text { font-size: 28rpx; margin-top: 20rpx; }

.card {
  background: #1a1a1a;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #2a2a2a;
}
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.title {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  flex: 1;
}
.target-badge {
  background: #2a2a2a;
  color: #aaa;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  font-size: 22rpx;
}
.status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}
.status-pending { background: #3a2f1a; color: #ffd76e; }
.status-handled { background: #1a3a2a; color: #6dd47e; }
.status-dismissed { background: #2a2a2a; color: #aaa; }
.status-ignored { background: #2a2a2a; color: #777; }

.meta {
  font-size: 24rpx;
  color: #aaa;
  line-height: 1.7;
}
.reason { color: #ffd76e; }

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.btn {
  font-size: 24rpx;
  padding: 10rpx 22rpx;
  border-radius: 8rpx;
}
.btn-danger { background: #3a1a1a; color: #ff7676; }
.btn-warn { background: #3a2f1a; color: #ffd76e; }
.btn-bad { background: #2a1a1a; color: #ff4d4f; }
.btn-ghost { background: #2a2a2a; color: #ccc; }

.loading {
  text-align: center;
  padding: 30rpx;
  color: #777;
  font-size: 24rpx;
}