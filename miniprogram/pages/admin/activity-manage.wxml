<view class="page">
  <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
    <view wx:for="{{tabs}}" wx:key="key"
          class="tab {{activeTab == item.key ? 'active' : ''}}"
          data-key="{{item.key}}" bindtap="switchTab">
      {{item.label}}
    </view>
  </scroll-view>

  <view wx:if="{{items.length == 0 && !loading}}" class="empty">
    <view class="empty-icon">📭</view>
    <view class="empty-text">暂无活动</view>
  </view>

  <view wx:for="{{items}}" wx:key="id" class="card">
    <view class="card-head">
      <view class="title">{{item.title}}</view>
      <view class="status status-{{item.status}}">{{item.status == 'pending' ? '待审核' : item.status == 'approved' ? '已发布' : item.status == 'rejected' ? '已驳回' : '已关闭'}}</view>
    </view>
    <view class="meta">
      <view>📍 {{item.location}}</view>
      <view>🕒 开始 {{item.startTime || item.start_time}}</view>
      <view>👤 组织者:{{item.organizerName || item.organizer_name}}</view>
      <view>👥 已报名 {{item.registeredCount || item.registered_count || 0}} / {{item.capacity || '不限'}}</view>
    </view>
    <view wx:if="{{item.reviewNote || item.review_note}}" class="note">📝 审核意见:{{item.reviewNote || item.review_note}}</view>

    <view class="actions">
      <view wx:if="{{item.status == 'pending'}}" class="btn btn-ok" data-id="{{item.id}}" data-action="approve" bindtap="onReview">✓ 通过</view>
      <view wx:if="{{item.status == 'pending'}}" class="btn btn-bad" data-id="{{item.id}}" data-action="reject" bindtap="onReview">✗ 驳回</view>
      <view wx:if="{{item.status == 'approved'}}" class="btn btn-warn" data-id="{{item.id}}" bindtap="onClose">⏹ 关闭</view>
      <view class="btn btn-ghost" data-id="{{item.id}}" bindtap="onShowRegistrations">👥 名单</view>
      <view class="btn btn-danger" data-id="{{item.id}}" bindtap="onDelete">🗑 删除</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:elif="{{finished && items.length > 0}}" class="loading">没有更多了</view>
</view>