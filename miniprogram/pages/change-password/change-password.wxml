<view class="page">
  <view class="form-card">
    <input class="input" password placeholder="原密码" data-field="old_password" bindinput="onFieldInput" />
    <input class="input" password placeholder="新密码（至少 6 位）" data-field="new_password" bindinput="onFieldInput" />
    <input class="input" password placeholder="确认新密码" data-field="confirm" bindinput="onFieldInput" />

    <view class="text-muted text-small" style="margin-top: 24rpx;">修改成功后将返回登录页，请牢记！</view>

    <button class="btn-primary" bindtap="onSubmit" disabled="{{submitting}}" style="margin-top: 32rpx;">
      {{submitting ? '提交中...' : '提 交'}}
    </button>
  </view>
</view>