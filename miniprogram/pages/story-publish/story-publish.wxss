.page { padding: 24rpx; background:#f5f5f5; min-height: 100vh; }
.form-card { background: #fff; border-radius: 24rpx; padding: 32rpx 24rpx; }

.form-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.form-label { width: 180rpx; font-size: 28rpx; color: #555; }
.form-input { flex: 1; font-size: 28rpx; }
.picker { font-size: 28rpx; color: #333; padding: 8rpx 0; }

.title-input {
  width: 100%;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f0f0f0;
}
.content-area {
  width: 100%;
  height: 320rpx;
  font-size: 28rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.image-area { margin-top: 24rpx; }
.image-list {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx;
}
.image-item {
  position: relative;
  width: 100%; height: 200rpx; border-radius: 12rpx; overflow: hidden;
  background: #eee;
}
.image { width: 100%; height: 100%; }
.image-remove {
  position: absolute; top: 4rpx; right: 4rpx;
  background: rgba(0,0,0,0.6); color: #fff;
  border-radius: 50%; width: 40rpx; height: 40rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; line-height: 1;
}
.image-add {
  width: 100%; height: 200rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: #999; font-size: 24rpx;
  gap: 8rpx;
  background: #fafafa;
  box-sizing: border-box;
}
