.page { padding: 24rpx; background: #f5f5f5; min-height: 100vh; }

.hero {
  background: linear-gradient(135deg, #1976d2, #42a5f5 60%, #26c6da);
  color: #fff;
  padding: 32rpx; border-radius: 24rpx;
  display: flex; align-items: center; gap: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(25,118,210,0.2);
}
.hero-icon { font-size: 80rpx; line-height: 1; }
.hero-content { flex: 1; }
.hero-title { font-size: 36rpx; font-weight: 700; }
.hero-sub { font-size: 24rpx; opacity: 0.9; margin-top: 8rpx; }

.loading { text-align: center; padding: 100rpx 0; }

.empty-state { text-align: center; padding: 100rpx 0; }
.empty-icon { font-size: 120rpx; opacity: 0.6; }
.empty-title { font-size: 30rpx; color: #666; margin-top: 16rpx; }
.empty-sub { font-size: 24rpx; margin-top: 8rpx; }
.empty-cta {
  display: inline-block; margin-top: 32rpx;
  background: linear-gradient(135deg, #1976d2, #42a5f5); color: #fff;
  padding: 16rpx 40rpx; border-radius: 48rpx; font-size: 28rpx;
}
.btn-hover { transform: scale(0.96); transition: transform 0.15s; }

.list { display: flex; flex-direction: column; gap: 20rpx; }
.ck-card {
  display: flex; padding: 20rpx; background: #fff;
  border-radius: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.card-hover { transform: scale(0.99); transition: transform 0.15s; }
.ck-cover {
  width: 180rpx; height: 140rpx; border-radius: 12rpx;
  background: #f0f0f0; flex-shrink: 0;
}
.ck-cover.fallback {
  background: #e3f2fd;
  display: flex; align-items: center; justify-content: center;
  font-size: 60rpx; color: #1976d2;
}
.ck-info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.ck-name { font-size: 30rpx; font-weight: 600; }
.ck-meta { margin-top: 8rpx; }
.ck-check {
  margin-top: auto;
  display: inline-block;
  background: #e8f5e9; color: #2e7d32;
  padding: 4rpx 14rpx; border-radius: 16rpx;
  font-size: 22rpx; align-self: flex-start;
}