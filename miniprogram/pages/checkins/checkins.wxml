<view class="page">
  <view class="hero">
    <view class="hero-icon">📍</view>
    <view class="hero-content">
      <view class="hero-title">我的打卡</view>
      <view class="hero-sub">已打卡 {{count}} 个兰马赛道地标</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading text-muted">加载中…</view>

  <view wx:elif="{{list.length === 0}}" class="empty-state">
    <view class="empty-icon">🗺</view>
    <view class="empty-title">还没有打卡记录</view>
    <view class="empty-sub text-muted">前往赛道地标,点击 📍 打卡即可记录</view>
    <view class="empty-cta" bindtap="goDetail" hover-class="btn-hover">去看看地标</view>
  </view>

  <view wx:else class="list">
    <view class="ck-card card" wx:for="{{list}}" wx:key="id" hover-class="card-hover"
          data-id="{{item.id}}" bindtap="goDetail">
      <image wx:if="{{item.cover}}" src="{{item.cover}}" class="ck-cover" mode="aspectFill" lazy-load="{{true}}"></image>
      <view wx:else class="ck-cover fallback">📍</view>
      <view class="ck-info">
        <view class="ck-name">{{item.name}}</view>
        <view class="ck-meta text-muted text-small">
          <text>{{item.category}}</text>
          <text wx:if="{{item.distance}}"> · 距起点 {{item.distance}} km</text>
        </view>
        <view class="ck-check">✓ 已打卡</view>
      </view>
    </view>
  </view>
</view>