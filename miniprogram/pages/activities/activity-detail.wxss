.detail {
  padding: 24rpx 24rpx 200rpx;
  min-height: 100vh;
  background: #f5f5f5;
}
.hero {
  background: linear-gradient(135deg, #b71c1c 0%, #d32f2f 100%);
  padding: 32rpx 24rpx;
  border-radius: 16rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.title {
  font-size: 36rpx;
  font-weight: 700;
  flex: 1;
  padding-right: 12rpx;
}
.status-pill {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.25);
}
.status-pending { background: rgba(255, 255, 255, 0.25); }
.status-open, .status-approved { background: rgba(255, 255, 255, 0.25); }
.status-closed, .status-rejected { background: rgba(0, 0, 0, 0.2); }

.info-card {
  background: #fff;
  border-radius: 16rpx;
  margin-top: 20rpx;
  overflow: hidden;
}
.info-row {
  display: flex;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.info-row:last-child { border-bottom: none; }
.info-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}
.info-body { flex: 1; }
.info-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}
.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.section-body {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}

.member-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.member-row:last-child { border-bottom: none; }
.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #ffcdd2;
  color: #b71c1c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 16rpx;
}
.member-name { flex: 1; font-size: 26rpx; color: #333; }
.member-status {
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #f5f5f5;
}

.invite-row {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #fff5f5;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}
.invite-code {
  font-size: 30rpx;
  font-weight: 700;
  color: #b71c1c;
  font-family: monospace;
  margin-right: 16rpx;
  flex: 1;
}
.invite-meta { font-size: 22rpx; color: #999; flex: 1; }
.invite-stop {
  font-size: 22rpx;
  color: #ff7676;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  background: #fff;
  border: 1rpx solid #ffcdd2;
}

.invite-create {
  font-size: 24rpx;
  color: #b71c1c;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  background: #fff5f5;
}
.invite-create-hover { opacity: 0.7; }

.empty-tip {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding: 20rpx 0;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  gap: 16rpx;
}
.phone-input {
  flex: 1;
  background: #fafafa;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 26rpx;
}
.btn {
  font-size: 28rpx;
  padding: 20rpx 36rpx;
  border-radius: 8rpx;
  text-align: center;
}
.btn-primary { background: #b71c1c; color: #fff; }
.btn-disabled { background: #ccc; color: #fff; }

.empty {
  text-align: center;
  padding: 200rpx 40rpx;
  color: #999;
}
.empty-icon { font-size: 96rpx; }
.empty-text { font-size: 28rpx; margin-top: 16rpx; }

.loading {
  text-align: center;
  padding: 80rpx;
  color: #999;
  font-size: 26rpx;
}