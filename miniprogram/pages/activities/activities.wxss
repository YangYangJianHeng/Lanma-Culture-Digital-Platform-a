.page {
  padding: 24rpx 24rpx 100rpx;
  min-height: 100vh;
  background: #f5f5f5;
}
.tabs {
  white-space: nowrap;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 4rpx 12rpx;
}
.tab {
  display: inline-block;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  color: #666;
}
.tab.active {
  color: #b71c1c;
  border-bottom: 4rpx solid #b71c1c;
  font-weight: 600;
}
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999;
}
.empty-icon { font-size: 96rpx; }
.empty-text { font-size: 28rpx; margin-top: 16rpx; color: #555; }
.empty-tip { font-size: 24rpx; margin-top: 8rpx; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  padding-right: 12rpx;
}
.status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}
.status-pending { background: #fff3e0; color: #ef6c00; }
.status-open { background: #e8f5e9; color: #2e7d32; }
.status-closed { background: #eee; color: #888; }
.status-rejected { background: #ffebee; color: #c62828; }

.meta {
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
  margin: 8rpx 0;
}
.meta-row { display: block; }

.desc {
  font-size: 24rpx;
  color: #999;
  background: #fafafa;
  padding: 12rpx;
  border-radius: 8rpx;
  margin: 12rpx 0;
  line-height: 1.6;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.organizer {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #b71c1c 0%, #d32f2f 100%);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(183, 28, 28, 0.4);
  z-index: 99;
}
.fab-hover { transform: scale(0.95); }

.loading {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}