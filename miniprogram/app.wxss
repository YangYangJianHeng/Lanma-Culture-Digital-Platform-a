/**app.wxss**/
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.row { display: flex; flex-direction: row; }
.col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }

.text-muted { color: #999; }
.text-primary { color: #b71c1c; }
.text-small { font-size: 24rpx; }
.text-bold { font-weight: 600; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.btn-primary {
  background: linear-gradient(135deg, #b71c1c, #d32f2f);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
}
.btn-primary[disabled] { opacity: 0.5; }

.btn-ghost {
  background: #fff;
  color: #b71c1c;
  border: 2rpx solid #b71c1c;
  border-radius: 48rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 76rpx;
  text-align: center;
}

.input {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.divider {
  height: 1rpx;
  background: #eee;
  margin: 24rpx 0;
}

.empty {
  text-align: center;
  color: #aaa;
  padding: 80rpx 0;
  font-size: 26rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  background: #fbe9e7;
  color: #b71c1c;
}

.tag-gray {
  background: #eee;
  color: #666;
}

.hover-scale { transform: scale(0.97); transition: transform 0.15s; }
.hover-bg { background: #fafafa; }
.noop { /* click empty handler */ }
